# Telegram Bot
BOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Local dev: sqlite. Production (Railway): создайте Postgres-сервис и возьмите URL,
# заменив схему postgres:// на postgresql+asyncpg://
DB_URL=sqlite+aiosqlite:///./data/chef.db

# FSM-состояние диалогов. Без него незаконченные онбординги и черновики меню
# теряются при каждом рестарте. На Railway: создать Redis-сервис и взять URL.
REDIS_URL=

# Misc
TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO
CLAUDE_MODEL=claude-sonnet-4-6
CONVERSATION_ENABLED=false

# Telegram ID операторов через запятую
SUPERADMIN_IDS=

# потолок токенов подписчика
SUB_MONTHLY_TOKEN_CAP_PER_FAMILY=
